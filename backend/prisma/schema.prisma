generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model playlist_songs {
  id          Int       @id @default(autoincrement())
  playlist_id Int
  song_id     Int
  added_at    DateTime? @default(now()) @db.Timestamp(6)
  playlists   playlists @relation(fields: [playlist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  songs       songs     @relation(fields: [song_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([playlist_id, song_id], map: "unique_playlist_song")
}

model playlists {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(100)
  user_id        Int
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  playlist_songs playlist_songs[]
  users          users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model songs {
  id             Int              @id @default(autoincrement())
  title          String           @db.VarChar(255)
  artist         String           @db.VarChar(255)
  album          String?          @db.VarChar(255)
  duration       Int
  audio_url      String
  cover_url      String?
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  playlist_songs playlist_songs[]
}

model users {
  id            Int         @id @default(autoincrement())
  username      String      @db.VarChar(50)
  email         String      @unique @db.VarChar(100)
  password_hash String
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  playlists     playlists[]
}
